  keywords = {Contrastive Learning},
  file = {/Users/pablomirallesgonzalez/Software/Zotero/storage/EPXGC8ZE/Richemond et al. - 2020 - BYOL works even without batch statistics.pdf;/Users/pablomirallesgonzalez/Software/Zotero/storage/7L246Z9I/2010.html}
